# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#   cp .env.example .env
# ---------------------------------------------------------------------------

# runtime
NODE_ENV=development
PORT=4000

# database
MONGO_URI=mongodb://127.0.0.1:27017/task_manager

# auth -- JWT_SECRET must be a long random string (>=32 chars) in production.
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# auth cookie
COOKIE_NAME=access_token
COOKIE_MAX_AGE_DAYS=7
# lax | strict | none   ("none" requires HTTPS and is only needed for a
# cross-site frontend on a different domain)
COOKIE_SAME_SITE=lax

# browser clients allowed to send cookies
CORS_ORIGIN=http://localhost:3000
# where the Google OAuth callback sends the browser after login
CLIENT_URL=http://localhost:3000

# google oauth (leave blank to disable the Google routes)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# rate limiting
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
GLOBAL_RATE_LIMIT_MAX=300

# dev only: also return the JWT in the JSON response so tools like Postman
# can read it. Leave false in production -- the cookie is the credential.
EXPOSE_TOKEN_IN_RESPONSE=false
